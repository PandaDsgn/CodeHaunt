# Copy to .env and fill in before running docker-compose up.

# JWT signing secret for participant/organizer login tokens
JWT_SECRET=change-me-jwt-secret

# xAI Grok — pool of 20 API keys, comma-separated, round-robin picked per AI chat request
GROK_API_KEYS=key1,key2,key3,...,key20
GROK_MODEL=grok-code-fast-1

# App database. SQLAlchemy driver prefix required: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
